    "@nestjs/swagger": "^12.0.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@scalar/nestjs-api-reference": "^1.1.9",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-zod": "^5.3.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^5.0.4",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "prisma": "^7.7.0",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
