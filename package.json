  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "biome check --write src test",
    "lint": "biome check src test",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:changed": "cross-env NODE_ENV=test vitest run --changed HEAD",
    "format:check": "biome format src test",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:cov": "cross-env NODE_ENV=test vitest run --coverage",
    "test:debug": "cross-env NODE_ENV=test vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "cross-env NODE_ENV=test tsx test/setup-db.ts && cross-env NODE_ENV=test vitest run --config ./test/vitest-e2e.config.mts",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
